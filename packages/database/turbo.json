{
  "$schema": "https://v2-9-0.turborepo.dev/schema.json",
  "extends": [
    "//"
  ],
  "tasks": {
    "migrate": {
      "passThroughEnv": [
        "DATABASE_URL"
      ]
    },
    "backfill:oauth-tokens": {
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL",
        "ENCRYPTION_KEY"
      ]
    }
  }
}
