#!/bin/bash
exec 2>&1

PGDATA=/var/lib/postgresql/data

chown postgres:postgres "$PGDATA"
chmod 0700 "$PGDATA"

# initdb otherwise stamps the cluster with whatever zone the host handed the container,
# and that zone is what DEFAULT now() writes into every timestamp column from then on.
if [ ! -f "$PGDATA/PG_VERSION" ]; then
    su postgres -c "/usr/lib/postgresql/17/bin/initdb --timezone=UTC -D $PGDATA"
fi

exec su postgres -c "/usr/lib/postgresql/17/bin/postgres -D $PGDATA -c listen_addresses=localhost"
