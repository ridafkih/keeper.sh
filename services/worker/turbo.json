{
  "$schema": "https://v2-9-0.turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "dev": {
      "passThroughEnv": [
        "LOG_LEVEL",
        "DATABASE_URL",
        "DATABASE_POOL_MAX",
        "REDIS_URL",
        "ENCRYPTION_KEY",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "GOOGLE_PROJECT_REQUESTS_PER_MINUTE",
        "MICROSOFT_CLIENT_ID",
        "MICROSOFT_CLIENT_SECRET",
        "MICROSOFT_TENANT_ID",
        "WORKER_CONCURRENCY",
        "BLOCK_PRIVATE_RESOLUTION",
        "PRIVATE_RESOLUTION_WHITELIST"
      ]
    },
    "start": {
      "passThroughEnv": [
        "LOG_LEVEL",
        "DATABASE_URL",
        "DATABASE_POOL_MAX",
        "REDIS_URL",
        "ENCRYPTION_KEY",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "GOOGLE_PROJECT_REQUESTS_PER_MINUTE",
        "MICROSOFT_CLIENT_ID",
        "MICROSOFT_CLIENT_SECRET",
        "MICROSOFT_TENANT_ID",
        "WORKER_CONCURRENCY",
        "BLOCK_PRIVATE_RESOLUTION",
        "PRIVATE_RESOLUTION_WHITELIST"
      ]
    }
  }
}
